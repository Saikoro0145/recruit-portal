# Path to your recruit root directory.
# If not set, defaults to the parent directory of recruit-portal/.
#
# Example:
#   RECRUIT_ROOT=/Users/yourname/Documents/recruit
RECRUIT_ROOT=

# AES-256-GCM key (Base64, 32 bytes) used to encrypt company passwords
# at rest in src/data/companies.json.
#
# Generate one with:
#   npm run gen-key
#
# Then paste the output here. NEVER commit this value.
RECRUIT_SECRET_KEY=
